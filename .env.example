# ThreadCap environment placeholders — copy to .env and fill. See docs/11-deployment.md §3.
# Postgres (Neon free)
DATABASE_URL=postgresql://user:pass@host.region.aws.neon.tech/threadcap?sslmode=require

# Redis (Upstash free)
REDIS_URL=rediss://default:token@host.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://host.upstash.io
UPSTASH_REDIS_REST_TOKEN=placeholder

# Storage (MVP local disk on Railway volume)
STORAGE_DIR=/data/uploads
THREADCAP_PUBLIC_BASE_URL=https://app.threadcap.app

# Auth (JWT) — replace in production
JWT_ACCESS_SECRET=replace-with-≥32-char-random
JWT_REFRESH_SECRET=replace-with-≥32-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder

# AI providers (Model Swap, packages/ai)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Envelope master key (AES-256-GCM) / HMAC for webhooks
MASTER_KEY=
WEBHOOK_HMAC_SECRET=

# Workers
CAPTURE_WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# CORS allow-list (comma separated)
CORS_ORIGINS=http://localhost:5173,chrome-extension://placeholder